{
    # Global options
    email {{ letsencrypt_email }}

    # Sites behind Cloudflare see the visitor, not the Cloudflare edge, in {client_ip} and logs.
    # Ranges from https://www.cloudflare.com/ips-v4 and /ips-v6 (2026-09-29); a request from any
    # other address keeps its own address, so sites not behind Cloudflare are unaffected.
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

# Production domains
n8n.{{ server_domain }} {
    reverse_proxy n8n:5678
}

qdrant.{{ server_domain }} {
    reverse_proxy qdrant:6333
}

langfuse.{{ server_domain }} {
    reverse_proxy langfuse-web:3000
}

pgadmin.{{ server_domain }} {
    reverse_proxy pgadmin:80 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Script-Name ""
    }
}

# pgWeb (host systemd service)
pgweb.{{ server_domain }} {
    reverse_proxy host.docker.internal:8081
}

# Staging domains
n8n-staging.{{ server_domain }} {
    reverse_proxy n8n:5678
}

qdrant-staging.{{ server_domain }} {
    reverse_proxy qdrant:6333
}

langfuse-staging.{{ server_domain }} {
    reverse_proxy langfuse-web:3000
}

pgadmin-staging.{{ server_domain }} {
    reverse_proxy pgadmin:80 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Script-Name ""
    }
}

pgweb-staging.{{ server_domain }} {
    reverse_proxy host.docker.internal:8081
}

# Import all application configurations from addons
import /etc/caddy/addons/*.conf
